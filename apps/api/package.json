{
  "name": "@demo/api",
  "version": "0.1.0",
  "description": "REST API for the Report a Road Issue demo (NestJS + Prisma + PostgreSQL)",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "oxlint --deny-warnings src/ test/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://demo:demo@localhost:5432/road_reports_test} sh -c 'prisma migrate deploy && vitest run --config ./vitest.config.integration.ts'",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "oxlint": "^1.58.0",
    "prisma": "7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2"
  }
}
